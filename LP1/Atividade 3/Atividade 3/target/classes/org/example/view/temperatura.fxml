<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.TemperaturaController">
   <padding>
      <Insets bottom="20" left="30" right="30" top="20" />
   </padding>
   <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Temperatura média mensal (°C)" />
   <GridPane alignment="CENTER" hgap="10" vgap="8">
      <Label text="Janeiro" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="txtJaneiro" promptText="°C" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <Label text="Fevereiro" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <TextField fx:id="txtFevereiro" promptText="°C" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label text="Março" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="txtMarco" promptText="°C" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <Label text="Abril" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <TextField fx:id="txtAbril" promptText="°C" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      <Label text="Maio" GridPane.columnIndex="0" GridPane.rowIndex="4" />
      <TextField fx:id="txtMaio" promptText="°C" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <Label text="Junho" GridPane.columnIndex="0" GridPane.rowIndex="5" />
      <TextField fx:id="txtJunho" promptText="°C" GridPane.columnIndex="1" GridPane.rowIndex="5" />
      <Label text="Julho" GridPane.columnIndex="2" GridPane.rowIndex="0" />
      <TextField fx:id="txtJulho" promptText="°C" GridPane.columnIndex="3" GridPane.rowIndex="0" />
      <Label text="Agosto" GridPane.columnIndex="2" GridPane.rowIndex="1" />
      <TextField fx:id="txtAgosto" promptText="°C" GridPane.columnIndex="3" GridPane.rowIndex="1" />
      <Label text="Setembro" GridPane.columnIndex="2" GridPane.rowIndex="2" />
      <TextField fx:id="txtSetembro" promptText="°C" GridPane.columnIndex="3" GridPane.rowIndex="2" />
      <Label text="Outubro" GridPane.columnIndex="2" GridPane.rowIndex="3" />
      <TextField fx:id="txtOutubro" promptText="°C" GridPane.columnIndex="3" GridPane.rowIndex="3" />
      <Label text="Novembro" GridPane.columnIndex="2" GridPane.rowIndex="4" />
      <TextField fx:id="txtNovembro" promptText="°C" GridPane.columnIndex="3" GridPane.rowIndex="4" />
      <Label text="Dezembro" GridPane.columnIndex="2" GridPane.rowIndex="5" />
      <TextField fx:id="txtDezembro" promptText="°C" GridPane.columnIndex="3" GridPane.rowIndex="5" />
   </GridPane>
   <HBox alignment="CENTER" spacing="20">
      <Button onAction="#calcular" prefWidth="150" text="Calcular" />
      <Button onAction="#voltar" prefWidth="150" text="Voltar" />
   </HBox>
   <TextArea fx:id="txtResultado" editable="false" prefHeight="250" />
</VBox>
