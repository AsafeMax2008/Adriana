<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="14" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ImagensController">
   <padding>
      <Insets bottom="20" left="30" right="30" top="20" />
   </padding>
   <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Classes das imagens" />
   <Button maxWidth="320" onAction="#abrirLojaDeRoupas" prefWidth="320" text="Imagem 1 - Loja de roupas" />
   <Button maxWidth="320" onAction="#abrirCiclismoNaTrilha" prefWidth="320" text="Imagem 2 - Ciclismo na trilha" />
   <Button maxWidth="320" onAction="#abrirMascarasAfricanas" prefWidth="320" text="Imagem 3 - Máscaras africanas" />
   <Button maxWidth="320" onAction="#abrirPenteadosDeManga" prefWidth="320" text="Imagem 4 - Penteados de mangá" />
   <Button onAction="#voltar" prefWidth="150" text="Voltar" />
</VBox>
