<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CiclismoNaTrilhaController">
   <padding>
      <Insets bottom="20" left="30" right="30" top="20" />
   </padding>
   <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Classe CiclismoNaTrilha" />
   <Label style="-fx-text-fill: #555555;" text="Imagem 2 - Ciclismo na trilha" />
   <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
      <VBox alignment="TOP_CENTER" spacing="10">
         <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>
         <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Ciclista" />
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Nome do ciclista" />
            <TextField fx:id="txtNomeCiclista" prefWidth="220" text="Ana" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Idade" />
            <TextField fx:id="txtIdade" prefWidth="220" text="28" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Velocidade média (km/h)" />
            <TextField fx:id="txtVelocidadeMedia" prefWidth="220" text="15" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#pedalar" text="Pedalar" />
            <TextField fx:id="txtPedalar" prefWidth="220" promptText="Horas pedalando" text="2" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#calcularTempo" text="Calcular tempo" />
            <TextField fx:id="txtCalcularTempo" prefWidth="220" promptText="Distância (km)" text="30" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#apresentar" text="Apresentar" />
         </HBox>
         <Separator />
         <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Bicicleta" />
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Marca da bicicleta" />
            <TextField fx:id="txtMarca" prefWidth="220" text="Caloi" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Nº de marchas" />
            <TextField fx:id="txtNumeroMarchas" prefWidth="220" text="21" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Marcha atual" />
            <TextField fx:id="txtMarchaAtual" prefWidth="220" text="1" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#trocarMarcha" text="Trocar marcha" />
            <TextField fx:id="txtTrocarMarcha" prefWidth="220" promptText="Nova marcha" text="7" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#frear" text="Frear" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#descreverBicicleta" text="Descrever bicicleta" />
         </HBox>
         <Separator />
         <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Trilha" />
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Nome da trilha" />
            <TextField fx:id="txtNomeTrilha" prefWidth="220" text="Trilha da Mata" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Comprimento (km)" />
            <TextField fx:id="txtComprimentoKm" prefWidth="220" text="12" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="200" text="Dificuldade" />
            <TextField fx:id="txtDificuldade" prefWidth="220" text="Média" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#calcularTempoEstimado" text="Calcular tempo estimado" />
            <TextField fx:id="txtCalcularTempoEstimado" prefWidth="220" promptText="Velocidade média (km/h)" text="15" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#ehLonga" text="É longa?" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Button minWidth="200" onAction="#descreverTrilha" text="Descrever trilha" />
         </HBox>
      </VBox>
   </ScrollPane>
   <TextArea fx:id="txtResultado" editable="false" prefHeight="90" wrapText="true" />
   <Button onAction="#voltar" prefWidth="150" text="Voltar" />
</VBox>
