<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CompraDescontoController">
   <padding>
      <Insets bottom="20" left="30" right="30" top="20" />
   </padding>
   <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Compra com desconto" />
   <GridPane alignment="CENTER" hgap="10" vgap="8">
      <Label text="Arroz" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="txtArroz" promptText="R$" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <Label text="Feijão" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <TextField fx:id="txtFeijao" promptText="R$" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label text="Óleo de soja" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="txtOleo" promptText="R$" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <Label text="Açúcar" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <TextField fx:id="txtAcucar" promptText="R$" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      <Label text="Café torrado e moído" GridPane.columnIndex="0" GridPane.rowIndex="4" />
      <TextField fx:id="txtCafe" promptText="R$" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <Label text="Macarrão" GridPane.columnIndex="2" GridPane.rowIndex="0" />
      <TextField fx:id="txtMacarrao" promptText="R$" GridPane.columnIndex="3" GridPane.rowIndex="0" />
      <Label text="Farinha" GridPane.columnIndex="2" GridPane.rowIndex="1" />
      <TextField fx:id="txtFarinha" promptText="R$" GridPane.columnIndex="3" GridPane.rowIndex="1" />
      <Label text="Fubá de milho" GridPane.columnIndex="2" GridPane.rowIndex="2" />
      <TextField fx:id="txtFuba" promptText="R$" GridPane.columnIndex="3" GridPane.rowIndex="2" />
      <Label text="Molho de tomate" GridPane.columnIndex="2" GridPane.rowIndex="3" />
      <TextField fx:id="txtMolho" promptText="R$" GridPane.columnIndex="3" GridPane.rowIndex="3" />
      <Label text="Sal" GridPane.columnIndex="2" GridPane.rowIndex="4" />
      <TextField fx:id="txtSal" promptText="R$" GridPane.columnIndex="3" GridPane.rowIndex="4" />
   </GridPane>
   <HBox alignment="CENTER" spacing="20">
      <Button onAction="#calcular" prefWidth="150" text="Calcular" />
      <Button onAction="#voltar" prefWidth="150" text="Voltar" />
   </HBox>
   <TextArea fx:id="txtRecibo" editable="false" prefHeight="260" />
</VBox>
